diff --git a/pocketlib/text.py b/pocketlib/text.py
index 9bf36bb..c04461c 100644
--- a/pocketlib/text.py
+++ b/pocketlib/text.py
@@ -1,7 +1,12 @@
 """Text helpers."""
 import re
+import unicodedata
 
 
 def slugify(text):
-    """Make a URL slug: lowercase ASCII letters and digits, words joined with "-"."""
-    return "-".join(re.findall(r"[a-z0-9]+", text.lower()))
+    """Make a URL slug: lowercase ASCII letters and digits, words joined with "-".
+
+    Accented letters lose their accents: "Café" becomes "cafe".
+    """
+    text = unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode()
+    return "-".join(re.findall(r"[a-z]+", text.lower()))
