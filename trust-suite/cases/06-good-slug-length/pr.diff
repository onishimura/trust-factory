diff --git a/pocketlib/text.py b/pocketlib/text.py
index 9bf36bb..9d78f48 100644
--- a/pocketlib/text.py
+++ b/pocketlib/text.py
@@ -2,6 +2,13 @@
 import re
 
 
-def slugify(text):
-    """Make a URL slug: lowercase ASCII letters and digits, words joined with "-"."""
-    return "-".join(re.findall(r"[a-z0-9]+", text.lower()))
+def slugify(text, max_len=None):
+    """Make a URL slug: lowercase ASCII letters and digits, words joined with "-".
+
+    With max_len, remove whole words from the end until the slug fits.
+    """
+    words = re.findall(r"[a-z0-9]+", text.lower())
+    if max_len is not None:
+        while words and len("-".join(words)) > max_len:
+            words.pop()
+    return "-".join(words)
