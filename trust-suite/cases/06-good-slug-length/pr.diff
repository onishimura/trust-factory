@@ -12,3 +12,9 @@ class SlugifyTest(unittest.TestCase):
 
     def test_keeps_digits(self):
         self.assertEqual(slugify("Route 66"), "route-66")
+
+    def test_max_len_drops_whole_words(self):
+        self.assertEqual(slugify("Hello big world", max_len=9), "hello-big")
+
+    def test_max_len_never_cuts_a_word(self):
+        self.assertEqual(slugify("Wonderful", max_len=4), "")
