#!/bin/bash
# Offline stand-in for "claude -p". In $CLAUDE_STUB_DIR, it logs the directory,
# the git author, the arguments and the files that the PR changes (calls.log),
# and it saves the --system-prompt value (system-prompt.md). If act.sh exists,
# it runs it in the current directory, as an agent would act. It prints a result
# whose structured output is $CLAUDE_STUB_DIR/output.json, and whose permission
# denials are $CLAUDE_STUB_DIR/denials.json (default: none).

{
  echo "cwd: $PWD"
  echo "author: ${GIT_AUTHOR_NAME:-}"
  printf 'arg: %s\n' "$@"
  echo "changed: $(git diff --name-only main...HEAD | paste -sd ' ' -)"
} >> "$CLAUDE_STUB_DIR/calls.log"
while [ $# -gt 0 ]; do
  [ "$1" = --system-prompt ] && printf '%s\n' "$2" > "$CLAUDE_STUB_DIR/system-prompt.md"
  shift
done
[ ! -f "$CLAUDE_STUB_DIR/act.sh" ] || bash "$CLAUDE_STUB_DIR/act.sh" > /dev/null
[ -f "$CLAUDE_STUB_DIR/denials.json" ] || echo '[]' > "$CLAUDE_STUB_DIR/denials.json"
jq -n --slurpfile v "$CLAUDE_STUB_DIR/output.json" --slurpfile d "$CLAUDE_STUB_DIR/denials.json" \
  '{type: "result", is_error: false, structured_output: $v[0], permission_denials: $d[0],
    total_cost_usd: 0.25, usage: {input_tokens: 1000, output_tokens: 200}}'
