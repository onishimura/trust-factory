#!/bin/bash
# Offline stand-in for "claude -p". In $CLAUDE_STUB_DIR, it logs the directory,
# the git author, the arguments and the files that the PR changes (calls.log),
# and it saves the --system-prompt value (system-prompt.md).
# The role is "builder" or "verifier", from the first line of the system prompt.
# For call n of a role, the structured output is <role>.<n>.json, else
# <role>.json, else output.json. Before it replies, it runs <role>.sh (else
# act.sh) in the current directory, as an agent would act. The permission
# denials come from denials.json (default: none).

dir=$CLAUDE_STUB_DIR
{
  echo "cwd: $PWD"
  echo "author: ${GIT_AUTHOR_NAME:-}"
  printf 'arg: %s\n' "$@"
  echo "changed: $(git diff --name-only main...HEAD 2> /dev/null | paste -sd ' ' -)"
} >> "$dir/calls.log"
role=agent
while [ $# -gt 0 ]; do
  if [ "$1" = --system-prompt ]; then
    printf '%s\n' "$2" > "$dir/system-prompt.md"
    case $2 in "You are the builder"*) role=builder ;; "You are the verifier"*) role=verifier ;; esac
  fi
  shift
done
n=$(($(cat "$dir/$role.count" 2> /dev/null || echo 0) + 1))
echo "$n" > "$dir/$role.count"
for act in "$dir/$role.sh" "$dir/act.sh"; do [ -f "$act" ] && { bash "$act" > /dev/null; break; }; done
for out in "$dir/$role.$n.json" "$dir/$role.json" "$dir/output.json"; do [ -f "$out" ] && break; done
[ -f "$dir/denials.json" ] || echo '[]' > "$dir/denials.json"
jq -n --slurpfile v "$out" --slurpfile d "$dir/denials.json" \
  '{type: "result", is_error: false, structured_output: $v[0], permission_denials: $d[0],
    total_cost_usd: 0.25, usage: {input_tokens: 1000, output_tokens: 200}}'
